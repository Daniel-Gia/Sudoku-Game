{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared" },
            "problemMatcher": [],
            "windows": { "command": "powershell", "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\windows\\build.ps1"] },
            "linux": { "command": "bash", "args": ["${workspaceFolder}/scripts/linux/build.sh"] }
        }
    ]
}
